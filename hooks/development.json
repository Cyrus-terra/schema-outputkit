{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
